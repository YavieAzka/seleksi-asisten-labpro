<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8" />
  <title>Applications | Control Panel Admin</title>
  <link rel="stylesheet" href="/styles.css" />
</head>

<body>
  <div class="layout">
    <aside class="sidebar">
      <h2>SSO Control Panel</h2>
      <a href="/dashboard">Dashboard</a>
      <a href="/users">Users</a>
      <a href="/groups">Groups</a>
      <a href="/applications" class="active">Applications</a>
      <a href="/policies">Policies</a>
    </aside>
    <main class="main-content">
      <div class="topbar">
        <h1>Applications</h1>
        <form method="POST" action="/logout">
          <button type="submit">Logout</button>
        </form>
      </div>
      <div class="actions-bar">
        <a href="/applications/new" class="btn btn-primary">+ Tambah Application</a>
      </div>
      <table>
        <thead>
          <tr>
            <th>Nama</th>
            <th>Client ID</th>
            <th>Status</th>
            <th>Redirect URIs</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% applications.forEach(function(app) { %>
            <tr>
              <td>
                <%= app.name %>
              </td>
              <td><code><%= app.clientId %></code></td>
              <td><span class="badge badge-<%= app.status %>">
                  <%= app.status %>
                </span></td>
              <td>
                <%= app.redirectUris.length %> URI
              </td>
              <td><a href="/applications/<%= app.id %>/edit" class="btn btn-secondary">Edit</a></td>
            </tr>
            <% }); %>
        </tbody>
      </table>
    </main>
  </div>
</body>

</html>