<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8" />
  <title>Groups | Control Panel Admin</title>
  <link rel="stylesheet" href="/styles.css" />
</head>

<body>
  <div class="layout">
    <aside class="sidebar">
      <h2>SSO Control Panel</h2>
      <a href="/dashboard">Dashboard</a>
      <a href="/users">Users</a>
      <a href="/groups" class="active">Groups</a>
      <a href="/applications">Applications</a>
      <a href="/policies">Policies</a>
    </aside>
    <main class="main-content">
      <div class="topbar">
        <h1>Groups</h1>
        <form method="POST" action="/logout">
          <button type="submit">Logout</button>
        </form>
      </div>
      <div class="actions-bar">
        <a href="/groups/new" class="btn btn-primary">+ Tambah Group</a>
      </div>
      <table>
        <thead>
          <tr>
            <th>Nama</th>
            <th>Deskripsi</th>
            <th>Jumlah Anggota</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% groups.forEach(function(group) { %>
            <tr>
              <td>
                <%= group.name %>
              </td>
              <td>
                <%= group.description || '-' %>
              </td>
              <td>
                <%= group.userGroups.length %> user
              </td>
              <td><a href="/groups/<%= group.id %>/edit" class="btn btn-secondary">Edit</a></td>
            </tr>
            <% }); %>
        </tbody>
      </table>
    </main>
  </div>
</body>

</html>