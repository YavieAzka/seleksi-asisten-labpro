<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <title>Edit Group — Control Panel Admin</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <h2>SSO Control Panel</h2>
      <a href="/dashboard">Dashboard</a>
      <a href="/users">Users</a>
      <a href="/groups" class="active">Groups</a>
      <a href="/applications">Applications</a>
      <a href="/policies">Policies</a>
    </aside>
    <main class="main-content">
      <div class="topbar">
        <h1>Edit Group</h1>
        <form method="POST" action="/logout">
          <button type="submit">Logout</button>
        </form>
      </div>
      <div class="card">
        <h3>Informasi Dasar</h3>
        <form method="POST" action="/groups/<%= group.id %>">
          <div class="form-row">
            <label for="name">Nama Group</label>
            <input type="text" id="name" name="name" value="<%= group.name %>" required />
          </div>
          <div class="form-row">
            <label for="description">Deskripsi</label>
            <input type="text" id="description" name="description" value="<%= group.description || '' %>" />
          </div>
          <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
        </form>
      </div>
      <div class="card">
        <h3>Anggota Group</h3>
        <% if (group.userGroups.length === 0) { %>
          <p>Belum ada anggota di group ini.</p>
        <% } else { %>
          <table>
            <thead><tr><th>Nama</th><th>Email</th></tr></thead>
            <tbody>
              <% group.userGroups.forEach(function(ug) { %>
                <tr><td><%= ug.user.name %></td><td><%= ug.user.email %></td></tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
        <p style="margin-top: 12px; font-size: 13px; color: #666;">
          Untuk menambah/menghapus anggota, kelola dari halaman <a href="/users">Users</a>.
        </p>
      </div>
      <a href="/groups" class="btn btn-secondary">← Kembali ke Daftar Group</a>
    </main>
  </div>
</body>
</html>
