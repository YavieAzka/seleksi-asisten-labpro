<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8" />
  <title>Setup MFA | Control Panel Admin</title>
  <link rel="stylesheet" href="/styles.css" />
</head>

<body>
  <div class="layout">
    <aside class="sidebar">
      <h2>SSO Control Panel</h2>
      <a href="/dashboard">Dashboard</a>
      <a href="/users" class="active">Users</a>
      <a href="/groups">Groups</a>
      <a href="/applications">Applications</a>
      <a href="/policies">Policies</a>
    </aside>
    <main class="main-content">
      <div class="topbar">
        <h1>Setup MFA untuk <%= user.name %>
        </h1>
        <form method="POST" action="/logout">
          <button type="submit">Logout</button>
        </form>
      </div>

      <div class="card" style="text-align: center;">
        <h3>1. Pindai QR Code</h3>
        <p>Buka aplikasi Google Authenticator, Authy, atau aplikasi serupa, lalu pindai QR code berikut:</p>
        <div style="margin: 20px 0;">
          <img src="<%= qrCodeUrl %>" alt="QR Code MFA"
            style="margin: 0 auto; border: 1px solid #ddd; padding: 10px; border-radius: 8px;" />
        </div>
        <p style="color: gray; font-size: 0.9em;">Atau masukkan kunci rahasia ini secara manual: <strong>
            <%= secret %>
          </strong></p>
      </div>

      <div class="card">
        <h3>2. Verifikasi Kode</h3>
        <form method="POST" action="/users/<%= user.id %>/mfa/setup">
          <input type="hidden" name="secret" value="<%= secret %>" />
          <div class="form-row">
            <label for="code">Masukkan 6-digit kode dari aplikasi:</label>
            <input type="text" id="code" name="code" required maxlength="6" pattern="[0-9]{6}"
              style="letter-spacing: 0.5em; text-align: center; font-family: monospace; font-size: 1.2em;" />
          </div>
          <% if (typeof error !=='undefined' && error) { %>
            <p style="color: red; margin-bottom: 10px;">
              <%= error %>
            </p>
            <% } %>
              <button type="submit" class="btn btn-primary">Verifikasi & Aktifkan MFA</button>
              <a href="/users/<%= user.id %>/edit" class="btn btn-secondary" style="margin-left: 10px;">Batal</a>
        </form>
      </div>
    </main>
  </div>
</body>

</html>