<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8" />
  <title>Tambah Policy | Control Panel Admin</title>
  <link rel="stylesheet" href="/styles.css" />
</head>

<body>
  <div class="layout">
    <aside class="sidebar">
      <h2>SSO Control Panel</h2>
      <a href="/dashboard">Dashboard</a>
      <a href="/users">Users</a>
      <a href="/groups">Groups</a>
      <a href="/applications">Applications</a>
      <a href="/policies" class="active">Policies</a>
    </aside>
    <main class="main-content">
      <div class="topbar">
        <h1>Tambah Policy Baru</h1>
        <form method="POST" action="/logout">
          <button type="submit">Logout</button>
        </form>
      </div>
      <div class="card">
        <p style="font-size: 13px; color: #666; margin-top: 0;">
          Policy menentukan group mana yang diperbolehkan mengakses aplikasi tertentu.
        </p>
        <form method="POST" action="/policies">
          <div class="form-row">
            <label for="applicationId">Application</label>
            <select id="applicationId" name="applicationId" required>
              <% applications.forEach(function(app) { %>
                <option value="<%= app.id %>">
                  <%= app.name %>
                </option>
                <% }); %>
            </select>
          </div>
          <div class="form-row">
            <label for="groupId">Group</label>
            <select id="groupId" name="groupId" required>
              <% groups.forEach(function(group) { %>
                <option value="<%= group.id %>">
                  <%= group.name %>
                </option>
                <% }); %>
            </select>
          </div>
          <p style="font-size: 13px; color: #666;">Effect: <strong>allow</strong> (default)</p>
          <button type="submit" class="btn btn-primary">Simpan</button>
          <a href="/policies" class="btn btn-secondary">Batal</a>
        </form>
      </div>
    </main>
  </div>
</body>

</html>