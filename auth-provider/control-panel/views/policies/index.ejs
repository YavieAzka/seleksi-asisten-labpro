<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <title>Policies | Control Panel Admin</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <h2>SSO Control Panel</h2>
      <a href="/dashboard">Dashboard</a>
      <a href="/users">Users</a>
      <a href="/groups">Groups</a>
      <a href="/applications">Applications</a>
      <a href="/policies" class="active">Policies</a>
    </aside>
    <main class="main-content">
      <div class="topbar">
        <h1>Application Group Policies</h1>
        <form method="POST" action="/logout">
          <button type="submit">Logout</button>
        </form>
      </div>
      <div class="actions-bar">
        <a href="/policies/new" class="btn btn-primary">+ Tambah Policy</a>
      </div>
      <table>
        <thead><tr><th>Application</th><th>Group</th><th>Effect</th><th>Aksi</th></tr></thead>
        <tbody>
          <% policies.forEach(function(policy) { %>
            <tr>
              <td><%= policy.application.name %></td>
              <td><%= policy.group.name %></td>
              <td><span class="badge badge-active"><%= policy.effect %></span></td>
              <td>
                <form method="POST" action="/policies/<%= policy.id %>/remove">
                  <button type="submit" class="btn btn-danger">Hapus</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </main>
  </div>
</body>
</html>
