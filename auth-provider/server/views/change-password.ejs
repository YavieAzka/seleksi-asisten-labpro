<!DOCTYPE html>
<html>
  <head>
    <title>Ganti Kata Sandi - SSO ITB</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-200 h-screen flex items-center justify-center">
    <div
      class="bg-white p-10 rounded-xl shadow-xl w-[400px] border-t-4 border-teal-600"
    >
      <div class="text-center mb-8">
        <h1 class="text-3xl font-extrabold text-gray-800">SSO ITB</h1>
        <p class="text-gray-500 text-sm mt-1">Ubah Kata Sandi Akun</p>
      </div>

      <!-- Menampilkan pesan error atau sukses jika ada (opsional, disesuaikan dengan flash message engine Anda) -->
      <!-- 
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 text-sm">
          <%= error %>
        </div>
      <% } %> 
      -->

      <!-- Form mengarah ke endpoint POST /auth/change-password yang kita buat sebelumnya -->
      <form action="/auth/change-password" method="POST" class="space-y-5">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">
            Kata Sandi Lama
          </label>
          <input
            type="password"
            name="oldPassword"
            required
            class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500"
            placeholder="Masukkan sandi saat ini"
          />
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">
            Kata Sandi Baru
          </label>
          <input
            type="password"
            name="newPassword"
            required
            minlength="6"
            class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500"
            placeholder="Minimal 6 karakter"
          />
        </div>

        <div class="pt-2">
          <button
            type="submit"
            class="w-full bg-teal-600 text-white font-bold py-3 rounded-lg hover:bg-teal-700 transition shadow-md"
          >
            Simpan & Cabut Semua Sesi
          </button>
        </div>
      </form>

      <!-- Tombol navigasi untuk kembali ke aplikasi atau halaman profil -->
      <div class="mt-6 text-center">
        <a
          href="/"
          class="text-sm text-teal-600 hover:text-teal-800 font-medium transition"
        >
          &larr; Kembali ke Beranda
        </a>
      </div>
    </div>
  </body>
</html>
