<!DOCTYPE html>
<html>
  <head>
    <title>Dashboard - SiEks</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-100 min-h-screen">
    <nav
      class="bg-blue-600 p-4 shadow-md text-white flex justify-between items-center"
    >
      <h1 class="text-xl font-bold">SiEks Dashboard</h1>
      <a
        href="/auth/logout"
        class="bg-red-500 hover:bg-red-600 px-4 py-2 rounded font-medium text-sm transition"
        >Logout</a
      >
    </nav>

    <main class="max-w-4xl mx-auto mt-10 p-6">
      <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-200">
        <div
          class="bg-blue-50 border-l-4 border-blue-500 p-6 mb-8 rounded-r-lg"
        >
          <h2 class="text-2xl font-bold text-gray-800">
            Selamat Datang, <%= profile.name %>!
          </h2>
          <div class="mt-4 text-gray-700 space-y-1">
            <p>
              <span class="font-semibold">Email Resmi:</span> <%= profile.email
              %>
            </p>
            <p class="text-sm text-gray-500">
              <span class="font-semibold">User ID:</span> <%= profile.sub %>
            </p>
          </div>
        </div>

        <h3 class="font-bold text-lg text-gray-800 border-b pb-2 mb-4">
          Informasi Akademik
        </h3>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 border rounded-lg bg-gray-50 text-center">
            <p class="text-gray-500 text-sm font-semibold">Status Mahasiswa</p>
            <p class="text-green-600 font-bold">Aktif</p>
          </div>
          <div class="p-4 border rounded-lg bg-gray-50 text-center">
            <p class="text-gray-500 text-sm font-semibold">SKS Lulus</p>
            <p class="text-gray-800 font-bold">84 SKS</p>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
