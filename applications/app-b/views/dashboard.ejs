<!DOCTYPE html>
<html>
  <head>
    <title>Dashboard - Edunek</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-50 min-h-screen">
    <nav
      class="bg-emerald-600 p-4 shadow-md text-white flex justify-between items-center"
    >
      <h1 class="text-xl font-bold">Edunek Dashboard</h1>
      <a
        href="/auth/logout"
        class="bg-red-500 hover:bg-red-600 px-4 py-2 rounded font-medium text-sm transition"
        >Logout Lokal</a
      >
    </nav>

    <main class="max-w-4xl mx-auto mt-10 p-6">
      <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-200">
        <div
          class="bg-emerald-50 border-l-4 border-emerald-500 p-6 mb-8 rounded-r-lg"
        >
          <h2 class="text-2xl font-bold text-gray-800">
            Selamat Datang di Kelas, <%= profile.name %>!
          </h2>
          <div class="mt-4 text-gray-700 space-y-1">
            <p>
              <span class="font-semibold">Email:</span> <%= profile.email %>
            </p>
            <p class="text-sm text-gray-500">
              <span class="font-semibold">Sistem ID:</span> <%= profile.sub %>
            </p>
          </div>
        </div>

        <h3 class="font-bold text-lg text-gray-800 border-b pb-2 mb-4">
          Mata Kuliah Aktif
        </h3>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 border rounded-lg bg-gray-50">
            <p class="text-emerald-700 font-bold">IF2210</p>
            <p class="text-gray-600 text-sm">Pemrograman Berorientasi Objek</p>
          </div>
          <div class="p-4 border rounded-lg bg-gray-50">
            <p class="text-emerald-700 font-bold">IF2220</p>
            <p class="text-gray-600 text-sm">Probabilitas dan Statistika</p>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
